# Agents spawned from the chat: local docker desktops (default) or H cloud agents
AGENT_BACKEND=docker     # "docker" | "h"
# LINGER_S is how long a finished agent's desktop stays viewable (default 90s)
# Chat spawns at most 4 agents per message; MAX_PARALLEL caps concurrent agents.
# NOTE: 4 parallel agents exceed the Holo free tier (10 req/min) — use a paid
# model (e.g. holo4-35b-a3b) for parallel runs.
# H Company Agents API — second run backend
RUN_BACKEND=             # "h" | "docker"; default h when a key is set
HAI_API_KEY=             # falls back to MODEL_API_KEY
HAI_AGENTS_BASE_URL=https://agp.eu.hcompany.ai/api/v2
HAI_AGENT=h/web-surfer-flash
HAI_MAX_STEPS=25
HAI_MAX_TIME_S=240
NEXT_PUBLIC_OFFICE_URL=http://127.0.0.1:3200
